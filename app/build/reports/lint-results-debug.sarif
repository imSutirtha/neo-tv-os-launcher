                                    "startLine": 79,
                                    "endLine": 84,
                                    "snippet": {
                                        "text": "    <string name=\"card_prompt_title\">New card from %1$s</string>\n    <string name=\"card_prompt_body\">%1$s can show a card on your home screen. Keeping it hidden leaves the app\\'s normal tile as it is.</string>\n    <string name=\"card_prompt_names\">The card is named \\'%1$s\\'. The app is \\'%2$s\\'.</string>\n    <string name=\"card_prompt_resigned\">%1$s was updated with a different signing key, so your earlier answer no longer applies. Decide again for its card.</string>\n    <string name=\"card_prompt_relabelled\">%1$s changed the name of its card since you decided. Decide again for it.</string>\n"
                                    }
                                }
                            }
                        }
